<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/inputbar_fill" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00EDEDF0"
                android:centerColor="@color/header_line"
                android:endColor="#00EDEDF0" />
        </shape>
    </item>
</layer-list>
